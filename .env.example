# Copy to .env (gitignored) and fill in. Secrets only — no settings.

# Anthropic API key for the brain LLM.
# If unset, brain runs in degraded echo mode.
ANTHROPIC_API_KEY=

# Deepgram for streaming STT. If unset, falls back to local Whisper.
DEEPGRAM_API_KEY=

# ElevenLabs for cloud TTS. If unset, falls back to local Piper.
ELEVENLABS_API_KEY=
